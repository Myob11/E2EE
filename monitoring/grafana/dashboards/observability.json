{
  "uid": "e2ee-observability",
  "title": "E2EE Operations",
  "tags": ["e2ee", "observability"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU Usage",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host Memory Usage",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|aufs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|aufs|overlay\"})) * 100",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Receive",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway Request Rate",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (method, path) (rate(api_gateway_requests_total[5m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Gateway Request Latency",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, path) (rate(api_gateway_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Endpoint Call Frequency (Logs)",
      "datasource": "Loki",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "sum by (service, method, path) (count_over_time({service=~\".*(api_gateway|auth_service|chat_service|message_service|media_service).*\"} |~ \"request method=\" | regexp \"method=(?P<method>[^ ]+) path=(?P<path>[^ ]+) status=(?P<status>[0-9]+)\" [5m]))",
          "legendFormat": "{{service}} {{method}} {{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service Accessibility",
      "datasource": "Prometheus",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "avg_over_time(up{job=\"services\"}[5m]) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service Downtime",
      "datasource": "Prometheus",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "(1 - avg_over_time(up{job=\"services\"}[5m])) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Application Logs",
      "datasource": "Loki",
      "gridPos": {"x": 0, "y": 40, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "{service=~\".+\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "stat",
      "title": "Log Lines / 5m",
      "datasource": "Loki",
      "gridPos": {"x": 0, "y": 50, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(count_over_time({service=~\".+\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Errors / 5m",
      "datasource": "Loki",
      "gridPos": {"x": 8, "y": 50, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(count_over_time({service=~\".+\"} |= \"ERROR\" [5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Log Streams / 5m",
      "datasource": "Loki",
      "gridPos": {"x": 16, "y": 50, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "count(count_over_time({service=~\".+\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
