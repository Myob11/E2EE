# ==============================================================================
# E2EE SECURITY CONFIGURATION - CHANGE ALL PASSWORDS BEFORE DEPLOYMENT
# ==============================================================================
# IMPORTANT: This file contains sensitive credentials.
# - Generate strong random passwords for production
# - Never commit actual credentials to git
# - Rotate passwords regularly
# - Use a secrets manager in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# ==============================================================================

# PostgreSQL Database (INTERNAL USE ONLY - NOT EXPOSED)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_DB=auth_db

# Redis Cache (INTERNAL USE ONLY - NOT EXPOSED)
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# MongoDB (INTERNAL USE ONLY - NOT EXPOSED)
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# MinIO Object Storage (INTERNAL USE ONLY - NOT EXPOSED)
MINIO_USER=CHANGE_ME_TO_SECURE_USERNAME
MINIO_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_32_CHARS

# Application Secrets
SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_SECRET_KEY

# ==============================================================================
# SECURITY NOTES:
# ==============================================================================
# 1. All databases are NOW INTERNAL ONLY - not exposed to the internet
# 2. Services communicate via Docker network only
# 3. Only nginx (port 80/443) and monitoring tools are internet-facing
# 4. Database ports are NOT exposed to host machine
# 5. All credentials use environment variables - never hardcoded
# 6. Generate passwords with: openssl rand -base64 32
# ==============================================================================
